{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "validate:env": "node scripts/validate-env.js",
    "doctor": "expo doctor",
    "prebuild:ios": "expo prebuild --platform ios",
    "build:ios": "npm run build:ios:production",
    "build:ios:simulator": "npm run validate:env && eas build --platform ios --profile simulator",
    "build:ios:preview": "npm run validate:env && eas build --platform ios --profile preview",
    "build:ios:production": "npm run validate:env && eas build --platform ios --profile production",
    "submit:ios": "npm run validate:env && eas submit --platform ios --profile production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.4.1",
    "@supabase/supabase-js": "^2.45.4",
    "axios": "^1.7.7",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^1.17.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1305.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "^5.3.3"
  },
  "private": true
}
