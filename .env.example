# Copy this file to .env before running Docker Compose locally.
# Keep this template free of real secrets; put them in .env instead.

# =============================================================================
# LOCAL DOCKER COMPOSE
# =============================================================================

COMPOSE_PROJECT_NAME=fitconnect
BIND_ADDR=127.0.0.1

NGINX_PORT=8088
WEB_PORT=8081
API_PORT=8000
BFF_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
OLLAMA_PORT=11434
PGADMIN_PORT=8080

# =============================================================================
# DATABASE
# =============================================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-password
POSTGRES_DB=fitconnect

# The Docker Compose API service derives DATABASE_URL from the POSTGRES_* values
# above and uses the internal host name "db".

# =============================================================================
# SUPABASE
# =============================================================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_API_BASE_URL=/api/v1
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
EXPO_PUBLIC_API_URL=http://localhost:8088
EXPO_PUBLIC_BFF_URL=http://localhost:8088

# =============================================================================
# OLLAMA
# =============================================================================

OLLAMA_CHAT_MODEL=gemma4:e4b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=llava:7b

# =============================================================================
# DIET CHAT AI API (server only)
# =============================================================================
# ollama: local Ollama (OLLAMA_CHAT_MODEL above).
# openai_compatible: hosted API using POST {CHAT_API_BASE_URL}/chat/completions.
# Example base URLs: https://api.openai.com/v1,
#   https://generativelanguage.googleapis.com/v1beta/openai, https://api.deepseek.com
# OpenRouter base URL: https://openrouter.ai/api/v1

CHAT_PROVIDER=ollama
CHAT_API_BASE_URL=
CHAT_API_KEY=your_chat_api_key_here
CHAT_API_MODEL=

# RAG embeddings: ollama or openai_compatible (server only).
# Empty EMBED_API_BASE_URL / EMBED_API_KEY fall back to CHAT_API_BASE_URL / CHAT_API_KEY.
# OpenRouter model: openai/text-embedding-3-small
# Keep query/document models identical. After changing models, re-embed with:
# python infra/scripts/embed_rag.py --force
EMBED_PROVIDER=ollama
EMBED_API_BASE_URL=
EMBED_API_KEY=
EMBED_API_MODEL=
# Must remain 768 to match rag_documents.embedding.
EMBED_DIMENSIONS=768
# Retrieval similarity threshold, inclusive range 0..1.
# With openai/text-embedding-3-small (768), 0.2 separated Korean nutrition questions
# (top match 0.24-0.44) from unrelated ones (max 0.13); 0.5 suits Ollama nomic-embed-text.
RAG_MATCH_THRESHOLD=0.5

# Food photos: ollama or openai_compatible (server only).
# Empty VISION_API_BASE_URL / VISION_API_KEY fall back to CHAT_API_BASE_URL / CHAT_API_KEY.
# OpenRouter model: qwen/qwen3-vl-8b-instruct
VISION_PROVIDER=ollama
VISION_API_BASE_URL=
VISION_API_KEY=
VISION_API_MODEL=

# Per-user daily diet AI limits; each day starts at midnight in Asia/Seoul.
DIET_CHAT_DAILY_LIMIT=50
DIET_IMAGE_DAILY_LIMIT=20

# =============================================================================
# APPLICATION
# =============================================================================

ENVIRONMENT=development
NODE_ENV=production
JWT_SECRET=replace-with-a-strong-local-secret
ALLOWED_ORIGINS=http://localhost:8088,http://localhost:3000,http://localhost:5173,http://localhost:8080
ENABLE_DEMO_FALLBACK=true
# FastAPI booking notifications; Compose defaults to http://bff:3000.
# Set this only for a custom server-to-server BFF address.
# BFF_INTERNAL_URL=http://localhost:3000

# =============================================================================
# OPTIONAL ADMIN UI
# =============================================================================

PGADMIN_DEFAULT_EMAIL=admin@fitconnect.local
PGADMIN_DEFAULT_PASSWORD=change-me-local-pgadmin-password

# =============================================================================
# SECURITY NOTES
# =============================================================================
#
# Production deployments should inject secrets through CI/CD, Docker secrets, or
# the target platform secret manager instead of checked-in env files.
#
# Do not put SUPABASE_SERVICE_ROLE_KEY, JWT_SECRET, POSTGRES_PASSWORD, OAuth
# client secrets, payment secrets, or private API keys in web/mobile public env
# variables. VITE_* and EXPO_PUBLIC_* values are bundled into client apps.
#
# SUPABASE_SERVICE_ROLE_KEY is server-only. Web and mobile apps must use only
# the Supabase anon key and rely on Row Level Security.
#
# Production must set:
#   ENVIRONMENT=production
#   ENABLE_DEMO_FALLBACK=false
#   ALLOWED_ORIGINS=https://your-real-web-domain.example
#
# Rotate any secret immediately if it was committed, posted in chat, printed in
# logs, bundled into a client build, or shared with an unauthorized person.
#
# Generate a JWT secret with:
#   openssl rand -base64 32
#
# Keep POSTGRES_PASSWORD URL-safe unless you also provide a correctly encoded
# DATABASE_URL in a production-specific override.
#
# See docs/security/production_secret_handling.md for the full production
# secret handling checklist.
